<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProfile name="stg | prod">
        <property name="TIME" value="%d{yyyy-MM-dd HH:mm:ss.SSS}"/>
    </springProfile>
    <springProfile name="!(stg | prod)">
        <property name="TIME" value="%d{HH:mm:ss.SSS}"/>
    </springProfile>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${TIME} %-5level [%X{transactionId:--}] [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
